# Copy to .env.local and fill in. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are visible in the browser; everything else is server-only.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public "anon"/publishable key: safe in the browser because row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret service-role key: server only. Used only to read/write Shopify tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (optional; phase 5) — without it, only the deterministic rules run --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Shopify app (optional; phase 7) ----------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Read-only. The app never writes to Shopify.
SHOPIFY_SCOPES=read_products
# 32-byte key for encrypting Shopify tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- App ----------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Cost guardrails ----------------------------------------------------------
MAX_PRODUCTS_PER_SCAN=500
MAX_LLM_CALLS_PER_SCAN=100
